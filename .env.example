# Set these through your hosting provider; never commit real secrets.
# Optional local-only administrator overrides. Otherwise generated on first run.
LOCAL_ADMIN_PHONE=
LOCAL_ADMIN_PASSWORD=
# Photon-compatible geocoding server; the public demo is suitable for light local testing only.
GEOCODER_URL=https://photon.komoot.io
# Legacy hosted preview uses separate ChatGPT identity; this test update is local-only.
ADMIN_EMAILS=owner@example.com
PAYMENTS_MODE=test
PAYMENT_SERVICE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional separately deployed HTTPS payment service; omitted means co-located service.
PAYMENT_SERVICE_URL=
